[Unit]
Description=CODARIS account API
After=network.target postgresql.service
[Service]
User=codaris
Group=codaris
EnvironmentFile=/etc/codaris/backend.env
ExecStart=/opt/codaris/codaris_server
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
[Install]
WantedBy=multi-user.target
