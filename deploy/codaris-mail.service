[Unit]
Description=CODARIS transactional mail queue
After=network.target postgresql.service
[Service]
Type=oneshot
User=codaris
Group=codaris
EnvironmentFile=/etc/codaris/backend.env
Environment=CODARIS_CREDENTIAL_FONT=/opt/codaris/current/DejaVuSans.ttf
ExecStart=/opt/codaris/current/codaris_server --mail-once
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0077
